protected override object PrepareCellForEdit(FrameworkElement editingElement, RoutedEventArgs editingEventArgs)
{
    // По умолчанию editingElement в DataGridTextColumn — это TextBox
    if (editingElement is TextBox textBox)
    {
        textBox.Focus();

        // Проверяем, было ли редактирование вызвано нажатием клавиши (вводом текста)
        if (editingEventArgs is TextCompositionEventArgs textArgs)
        {
            // Устанавливаем введенный символ как текст и ставим каретку в конец
            textBox.Text = textArgs.Text;
            textBox.SelectionStart = textBox.Text.Length;
        }
        else
        {
            // Если вошли через F2 или DoubleClick — выделяем всё содержимое
            textBox.SelectAll();
        }
    }
    return base.PrepareCellForEdit(editingElement, editingEventArgs);
}



public class WeakRelayCommand : ICommand
{
    private readonly WeakReference _targetRef; // хранит слабую ссылку
    private readonly Action<object> _method;

    public WeakRelayCommand(Action<object> execute, object target)
    {
        _targetRef = new WeakReference(target);
        _method = execute;
    }

    public bool CanExecute(object parameter)
    {
        return _targetRef.Target != null; // проверяет, жив ли объект
    }

    public void Execute(object parameter)
    {
        if (_targetRef.Target != null)
        {
            _method(parameter);
        }
    }

    public event EventHandler CanExecuteChanged
    {
        add { CommandManager.RequerySuggested += value; }
        remove { CommandManager.RequerySuggested -= value; }
    }
}



