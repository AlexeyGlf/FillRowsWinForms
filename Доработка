// Файл MyClass.h
class TMyClass {
private:
    void (__closure *m_callback)(int);  // __closure - особенность C++ Builder
    int m_value;
    
public:
    TMyClass() : m_callback(NULL), m_value(0) {}
    
    // Устанавливаем callback
    void SetCallback(void (__closure *callback)(int)) {
        m_callback = callback;
    }
    
    void DoSomething() {
        // Вызываем callback, если он установлен
        if (m_callback) {
            m_callback(m_value);
        }
    }
    
    void SetValue(int val) { m_value = val; }
};

// Файл Unit1.h (главная форма)
#include "MyClass.h"

class TForm1 : public TForm {
    __published: // IDE-managed Components
        TButton *Button1;
        TEdit *Edit1;
    private:
        TMyClass *m_processor;
    public:
        __fastcall TForm1(TComponent* Owner);
        __fastcall ~TForm1();
        
        // Метод, который будет вызываться как callback
        void __fastcall OnProcess(int value);
        
    protected:
        void __fastcall Button1Click(TObject *Sender);
};

// Файл Unit1.cpp
__fastcall TForm1::TForm1(TComponent* Owner) : TForm(Owner) {
    m_processor = new TMyClass();
    
    // Устанавливаем callback - передаем указатель на метод
    m_processor->SetCallback(OnProcess);
}

__fastcall TForm1::~TForm1() {
    delete m_processor;
}

void __fastcall TForm1::OnProcess(int value) {
    // Этот метод вызовется из TMyClass::DoSomething()
    Edit1->Text = IntToStr(value * 2);
}

void __fastcall TForm1::Button1Click(TObject *Sender) {
    m_processor->SetValue(5);
    m_processor->DoSomething(); // Здесь вызовется OnProcess
}
