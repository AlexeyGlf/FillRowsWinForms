<Window.Resources>
    <DataTemplate x:Key="SingleColumnTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SomeProperty}"/>
        </Grid>
    </DataTemplate>
    
    <DataTemplate x:Key="TwoColumnTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SomeProperty}"/>
            <TextBlock Grid.Column="1" Text="{Binding ExtraProperty}"/>
        </Grid>
    </DataTemplate>
    
    <local:MyDataTemplateSelector x:Key="TemplateSelector"
        SingleColumnTemplate="{StaticResource SingleColumnTemplate}"
        TwoColumnTemplate="{StaticResource TwoColumnTemplate}"/>
</Window.Resources>

<ListBox ItemsSource="{Binding YourItems}"
         ItemTemplateSelector="{StaticResource TemplateSelector}"/>




public class MyDataTemplateSelector : DataTemplateSelector
{
    public DataTemplate SingleColumnTemplate { get; set; }
    public DataTemplate TwoColumnTemplate { get; set; }
    
    public override DataTemplate SelectTemplate(object item, DependencyObject container)
    {
        var yourItem = item as YourClass;
        
        if (yourItem != null && yourItem.YourBooleanProperty)
            return TwoColumnTemplate;
        else
            return SingleColumnTemplate;
    }
}
