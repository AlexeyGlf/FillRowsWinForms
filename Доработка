typedef void __fastcall (__closure *TMyEvent)(int);

class TMyClass {
private:
    TMyEvent FOnProcess;
    
public:
    __property TMyEvent OnProcess = {read=FOnProcess, write=FOnProcess};
    
    void Execute() {
        if (FOnProcess) {
            FOnProcess(100);
        }
    }
};

// Файл Unit1.h
class TForm1 : public TForm {
    __published:
        TButton *Button1;
    private:
        TMyClass *m_processor;
    public:
        __fastcall TForm1(TComponent* Owner);
        __fastcall ~TForm1();
        
    protected:
        void __fastcall Button1Click(TObject *Sender);
        void __fastcall MyProcessHandler(int value);
};

// Файл Unit1.cpp
__fastcall TForm1::TForm1(TComponent* Owner) : TForm(Owner) {
    m_processor = new TMyClass();
    m_processor->OnProcess = MyProcessHandler;
}

__fastcall TForm1::~TForm1() {
    delete m_processor;
}

void __fastcall TForm1::MyProcessHandler(int value) {
    ShowMessage("Value: " + IntToStr(value));
}

void __fastcall TForm1::Button1Click(TObject *Sender) {
    m_processor->Execute();
}


